[merge]
    tool = vscode
[mergetool "vscode"]
    cmd = code --wait $MERGED
[diff]
    tool = vscode
[difftool "vscode"]
    cmd = code --wait --diff $LOCAL $REMOTE
[core]
    editor = "code --wait"
    sshCommand="ssh -i ~/.ssh/personal_key"
[init]
	defaultBranch = main
[pull]
    rebase = false
[fetch]
    prune = true
[user]
    name = Camilo Duran
    email = camilod529@gmail.com
    username = camilod529
[github]
    user = camilod529
[includeIf "gitdir:~/projects/work/"]
    path = ~/.gitconfig-work
[alias]
    undo = reset --soft HEAD^
    rebranch = "!f() { git branch -D \"$1\" && git checkout -b \"$1\"; }; f"
    fpush = "!f() { git push --set-upstream origin \"$1\" --force; }; f"
    fpushme = "!git push --force --set-upstream origin $(git rev-parse --abbrev-ref HEAD)"
    pushme = "!git push -u origin $(git rev-parse --abbrev-ref HEAD)"
    coqa = "!b=$(git rev-parse --abbrev-ref HEAD)-qa && (git rev-parse --verify $b >/dev/null 2>&1 && git checkout $b || git checkout -b $b)"
    coprod = "!b=$(git rev-parse --abbrev-ref HEAD)-prod && (git rev-parse --verify $b >/dev/null 2>&1 && git checkout $b || git checkout -b $b)"
    gobase = "!f() { \
        b=$(git rev-parse --abbrev-ref HEAD); \
        base=$(echo \"$b\" | sed -E 's/(-qa|-dev|-prod|-staging)$//'); \
        echo Switching to $base && git checkout \"$base\"; \
    }; f"
    codev = "!b=$(git rev-parse --abbrev-ref HEAD)-dev && (git rev-parse --verify $b >/dev/null 2>&1 && git checkout $b || git checkout -b $b)"
    costg = "!b=$(git rev-parse --abbrev-ref HEAD)-staging && (git rev-parse --verify $b >/dev/null 2>&1 && git checkout $b || git checkout -b $b)"
    stg = "!git branch -D staging && git checkout staging && git pull origin staging"
    qa = "!git branch -D qa && git checkout qa && git pull origin qa"
    dev = "!git branch -D dev && git checkout dev && git pull origin dev"
    prod = "!git branch -D prod && git checkout prod && git pull origin prod"
    lg = log --oneline --graph --decorate --all
    last = log -1 HEAD
    reqa = "!f() { \
        current=$(git rev-parse --abbrev-ref HEAD); \
        new_branch=\"${current}-qa\"; \
        git branch -D \"$new_branch\" 2>/dev/null || true; \
        git checkout -b \"$new_branch\"; \
    }; f"
    reprod = "!f() { \
        current=$(git rev-parse --abbrev-ref HEAD); \
        new_branch=\"${current}-prod\"; \
        git branch -D \"$new_branch\" 2>/dev/null || true; \
        git checkout -b \"$new_branch\"; \
    }; f"
    redev = "!f() { \
        current=$(git rev-parse --abbrev-ref HEAD); \
        new_branch=\"${current}-dev\"; \
        git branch -D \"$new_branch\" 2>/dev/null || true; \
        git checkout -b \"$new_branch\"; \
    }; f"
    mergebase = "!f() { \
        b=$(git rev-parse --abbrev-ref HEAD); \
        base=$(echo \"$b\" | sed -E 's/(-qa|-dev|-prod|-staging)$//'); \
        echo Merging from $base into $b && git merge \"$base\"; \
    }; f"

